{
  "app": {
    "name": "CHAPPIE - AI Desktop Agent",
    "version": "2.0.0",
    "philosophy": "Code-heavy, minimal LLM usage, self-learning"
  },
  "llm": {
    "provider": "ollama",
    "ollama_url": "http://localhost:11434",
    "model": "mistral",
    "temperature": 0.3,
    "context_window": 4096,
    "timeout": 60,
    "_provider_examples": {
      "ollama_local": {
        "provider": "ollama",
        "ollama_url": "http://localhost:11434",
        "model": "mistral"
      },
      "kimi_k2": {
        "provider": "openai_compatible",
        "base_url": "https://api.moonshot.ai/v1",
        "model": "kimi-k2-turbo-preview",
        "api_key_env": "MOONSHOT_API_KEY"
      },
      "qwen": {
        "provider": "openai_compatible",
        "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
        "model": "qwen-plus",
        "api_key_env": "DASHSCOPE_API_KEY"
      },
      "openrouter": {
        "provider": "openai_compatible",
        "base_url": "https://openrouter.ai/api/v1",
        "model": "moonshotai/kimi-k2",
        "api_key_env": "OPENROUTER_API_KEY"
      }
    }
  },
  "llm_system_prompt": "You are CHAPPIE — a personal AI assistant in the style of JARVIS. Be concise, capable, and direct. Never say 'I'm just an AI'.",
  "skills": {
    "document_dir": "~/Documents/CHAPPIE",
    "calendar_dir": "~/Documents/CHAPPIE/calendar",
    "notes_dir": "~/Documents/CHAPPIE",
    "document_auto_open": true,
    "calendar_auto_open": true,
    "default_event_minutes": 60
  },
  "smtp": {
    "enabled": false,
    "host": "smtp.gmail.com",
    "port": 587,
    "user": "",
    "password_env": "SMTP_PASSWORD",
    "from": ""
  },
  "knowledge_base": {
    "persistent": true,
    "learn_from_interactions": true,
    "context_window_ttl": 3600,
    "max_memory_entries": 1000,
    "db_path": "data/chappie.db"
  },
  "security": {
    "require_confirmation_for": ["system_command", "delete_file"],
    "dangerous_keywords": ["__import__", "eval", "rm -rf", "sudo"]
  },
  "whisper": {
    "model": "base",
    "language": "en"
  },
  "tts": {
    "engine": "pyttsx3",
    "rate": 180,
    "voice": "default"
  },
  "browser_automation": {
    "headless": false,
    "user_data_dir": "data/browser_profile",
    "timeout_ms": 15000
  }
}
